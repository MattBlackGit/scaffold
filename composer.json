{
    "name":"ngaje/scaffold",
    "type":"library",
    "description":"micro framework for CMS integration",
    "authors": [
        {
            "name":"Russell Walker"
        },
        {
            "name": "Chris Haythornthwaite",
            "homepage": "https://www.itsgone.com/"
        }
    ],
    "autoload": {
         "psr-4": {
             "Ngaje\\Scaffold\\":"src",
             "Ngaje\\Scaffold\\Tools\\":"tools"
         }
    },
    "require": {
        "php":"^7.4|^8.0",
        "willdurand/negotiation": "1.4.0",
        "doctrine/annotations": "^1.14",
        "doctrine/common": "^3.0",
        "doctrine/dbal": "^2.10",
        "doctrine/orm": "^2.10",
        "doctrine/migrations": "^3.0",
        "pimple/pimple": "~3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6|^10.5|^11.5|^12.0|^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Ngaje\\Scaffold\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --colors=never"
    },
    "minimum-stability": "stable"
}
